{
	"name": "notebook",
	"main": "src/server/api/index.js",
	"compatibility_date": "2026-07-12",
	"workers_dev": false,
	"preview_urls": true,
	"observability": {
		"enabled": false,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true
		}
	},
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "notebook_db",
			"database_id": "6a6d353b-1274-4a90-b22c-fc57d45f403b",
			"migrations_dir": "./src/server/db/migrations"
		}
	],
	"kv_namespaces": [
		{
			"binding": "NOTEBOOKS",
			"id": "f670095e77d14cf29ef9b245f895c66e"
		}
	]
}